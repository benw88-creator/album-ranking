<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>VINALL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<!-- The avatar picker is a plain <input type="file" accept="image/*"> in the
	     webview, and WKWebView's upload sheet offers Photo Library, Take Photo
	     and Choose File whether or not this app asked for a camera. Tapping
	     Take Photo with no NSCameraUsageDescription is not a refused
	     permission, it is an immediate crash — so the string has to be here
	     even though no Capacitor camera plugin is installed. The photo-library
	     string is the same belt-and-braces: modern iOS serves that branch
	     through PHPicker, which needs no permission, but older paths do not. -->
	<key>NSCameraUsageDescription</key>
	<string>VINALL asks for the camera only if you choose Take Photo when setting your profile picture. Nothing is recorded otherwise.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>VINALL asks for your photos only when you pick a profile picture. The image you choose is the only one it reads.</string>
	<!-- Every connection this app makes is ordinary HTTPS and nothing else is
	     encrypted, which is exempt. Declaring it here means App Store Connect
	     stops asking the export-compliance question on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Portrait only, on both. Every layout in this app is mobile-first and
	     portrait: the album page is a sleeve above a tracklist, the nav is a
	     floating bar at thumb height, and the game sheets are bottom sheets.
	     None of it has a landscape design, so allowing the rotation was
	     offering a broken screen rather than a feature. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<!-- Shake-to-undo off. It is a system alert ("Undo Typing") thrown over
	     the app by a gesture nobody performs on purpose, and this app has no
	     text editing deep enough to want it. -->
	<key>UIApplicationSupportsShakeToEdit</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
